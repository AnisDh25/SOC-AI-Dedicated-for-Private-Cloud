# {{ ansible_managed }}
[DEFAULT]
log_dir = /var/log/designate
transport_url = {{ rabbit_url }}
root_helper = sudo designate-rootwrap /etc/designate/rootwrap.conf

[database]
connection = mysql+pymysql://designate:{{ vault_db_passwords.designate }}@{{ controller_fqdn }}:3306/designate

[service:api]
listen = {{ api_bind_host }}:9001
auth_strategy = keystone
api_base_uri = https://{{ network_fqdn }}:9001
enable_api_v2 = True
enabled_extensions_v2 = quotas, reports

[keystone_authtoken]
www_authenticate_uri = {{ keystone_url }}
auth_url = {{ keystone_url }}
memcached_servers = {{ memcached_servers }}
auth_type = password
project_domain_name = Default
user_domain_name = Default
project_name = service
username = designate
password = {{ vault_service_passwords.designate }}
insecure = false

[service:worker]
enabled = True
notify = True

[storage:sqlalchemy]
connection = mysql+pymysql://designate:{{ vault_db_passwords.designate }}@{{ controller_fqdn }}:3306/designate

[oslo_policy]
enforce_new_defaults = true
