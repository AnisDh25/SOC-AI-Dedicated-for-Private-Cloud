# {{ ansible_managed }}
[DEFAULT]
heat_stack_user_role = heat_stack_user
stack_user_domain_name = heat
stack_domain_admin = heat_domain_admin
stack_domain_admin_password = {{ vault_heat_domain_admin_password }}
transport_url = {{ rabbit_url }}

[database]
connection = mysql+pymysql://heat:{{ vault_db_passwords.heat }}@{{ controller_fqdn }}:3306/heat

[clients_keystone]
auth_uri = {{ keystone_url }}

[heat_api]
bind_host = {{ mgmt_ip }}
bind_port = 8004

[heat_api_cfn]
bind_host = {{ mgmt_ip }}
bind_port = 8000

[keystone_authtoken]
www_authenticate_uri = {{ keystone_url }}
auth_url = {{ keystone_url }}
memcached_servers = {{ memcached_servers }}
auth_type = password
project_domain_name = Default
user_domain_name = Default
project_name = service
username = heat
password = {{ vault_service_passwords.heat }}
service_token_roles = service
service_token_roles_required = true
insecure = false

[trustee]
auth_url = {{ keystone_url }}
auth_type = password
user_domain_name = Default
username = heat
password = {{ vault_service_passwords.heat }}

[oslo_policy]
enforce_new_defaults = true
