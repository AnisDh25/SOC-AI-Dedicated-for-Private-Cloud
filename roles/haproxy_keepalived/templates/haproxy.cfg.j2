# {{ ansible_managed }}
# Service frontends live in /etc/haproxy/conf.d/<service>.cfg
global
    log /dev/log local0
    log /dev/log local1 notice
    chroot /var/lib/haproxy
    stats socket /run/haproxy/admin.sock mode 660 level admin
    user haproxy
    group haproxy
    daemon
    maxconn 20000
    ssl-default-bind-options ssl-min-ver TLSv1.2

defaults
    log     global
    mode    tcp
    option  tcplog
    option  dontlognull
    option  tcpka
    timeout connect 10s
    timeout client  10m
    timeout server  10m
    timeout check   5s

# Stats page, also used as the "VIP is up" probe (http://<vip>:1936/)
listen stats
    bind {{ vip_address }}:1936
    bind {{ mgmt_ip }}:1936
    mode http
    stats enable
    stats uri /
    stats refresh 10s
    stats show-legends
